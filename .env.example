# ── کانال بله ──
# توکن را از @BotFather در بله بگیرید. شناسه‌ی کانال: @username کانال
BALE_TOKEN=
BALE_CHAT_ID=@your_bale_channel

# ── کانال ایتا (از طریق ایتایار) ──
# توکن را از پنل eitaayar.ir بگیرید. شناسه‌ی کانال: آیدی کانال بدون @ یا شناسه‌ی عددی
EITAA_TOKEN=
EITAA_CHAT_ID=gheymat_lahzei

# ── کانال تلگرام ──
# توکن را از @BotFather در تلگرام بگیرید. شناسه‌ی کانال: @username کانال
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=@your_telegram_channel

# هر چند دقیقه یک پست
INTERVAL_MINUTES=10

# ساعت‌های سکوت به وقت تهران (خالی = همیشه). مثال: 0-7
QUIET_HOURS=

# اقلام. مجاز: usd,usdt,gold18,coin,quarter,silver,gold_oz,silver_oz,oil,btc,eth
ITEMS=usd,usdt,gold18,coin,quarter,silver,gold_oz,silver_oz,oil,btc,eth

# نمایش بخش حباب سکه و طلا (0 = خاموش)
SHOW_BUBBLE=1

# سرتیتر و پانویس پست (پانویس مثلاً آیدی کانال)
HEADER=📊 قیمت لحظه‌ای بازار
FOOTER=🆔 @gheymat_lahzei
