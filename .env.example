# ── کانال بله ──
# توکن را از @BotFather در بله بگیرید. شناسه‌ی کانال: @username کانال
BALE_TOKEN=
BALE_CHAT_ID=@your_bale_channel

# ── کانال ایتا (از طریق ایتایار) ──
# توکن را از پنل eitaayar.ir بگیرید. شناسه‌ی کانال: آیدی کانال بدون @ یا شناسه‌ی عددی
EITAA_TOKEN=
EITAA_CHAT_ID=gheymat_lahzei

# ── کانال تلگرام ──
# توکن را از @BotFather در تلگرام بگیرید. شناسه‌ی کانال: @username کانال
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=@your_telegram_channel

# هر چند دقیقه پیام پین‌شده به‌روز شود
INTERVAL_MINUTES=10

# پیام پین‌شده‌ی زنده در تلگرام و بله (0 = خاموش)
LIVE_MESSAGE=1

# ساعت‌های شب به وقت تهران: پست کمتر و بی‌صدا، هر NIGHT_EVERY ساعت یک‌بار
NIGHT_HOURS=0-7
NIGHT_EVERY=3

# ساعت‌هایی که پست ساعتی به‌صورت تصویر می‌رود
IMAGE_HOURS=10,14,18,22

# ساعت خلاصه‌ی روزانه و ساعت نمودار هفتگی جمعه
SUMMARY_HOUR=20
CHART_HOUR=12

# هشدار نوسان: اگر این اقلام در یک ساعت بیش از ALERT_PCT درصد جابه‌جا شوند
ALERT_ITEMS=usd,gold18
ALERT_PCT=1

# پین کردن پست ساعتی در ایتا (ایتایار ویرایش ندارد)
EITAA_PIN=1

# ساعت‌های سکوت کامل به وقت تهران (خالی = ندارد). مثال: 2-6
QUIET_HOURS=

# اقلام. مجاز: gold18,coin,bahar,half,quarter,gerami,silver,usd,eur,aed,try,usdt,
#              btc,eth,gold_oz,silver_oz,oil
ITEMS=gold18,coin,bahar,half,quarter,silver,usd,eur,aed,try,usdt,btc,eth,gold_oz,silver_oz,oil

# نمایش بخش حباب سکه و طلا (0 = خاموش)
SHOW_BUBBLE=1

# سرتیتر و پانویس پست (پانویس مثلاً آیدی کانال)
HEADER=📊 قیمت لحظه‌ای بازار
FOOTER=🆔 @gheymat_lahzei
